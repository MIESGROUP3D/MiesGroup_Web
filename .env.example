# Copiar a .env.local (no se sube a git)

# Envío de correos del formulario de contacto (https://resend.com)
# Sin esta variable, el formulario funciona en modo mockup (solo registra en consola).
RESEND_API_KEY=

# Destinatario de los mensajes del formulario (por defecto: site.email en src/content/site.ts)
CONTACT_TO=

# Remitente: debe ser de un dominio verificado en Resend
CONTACT_FROM="MIES Web <web@miesgroup3d.com>"
